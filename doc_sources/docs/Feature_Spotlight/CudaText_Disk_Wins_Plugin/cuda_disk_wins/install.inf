[info]
title=Disk Wins (Auto-Reload)
desc=Ignores unsaved editor changes and silently reloads files from disk whenever they change externally - no confirmation dialog.
type=cudatext-plugin
subdir=cuda_disk_wins
homepage=

[item1]
section=events
events=on_start2,on_open,on_save

[item11]
section=commands
caption=Disk Wins\Toggle auto-reload on/off
method=cmd_toggle

[item12]
section=commands
caption=Disk Wins\Check now
method=cmd_check_now
