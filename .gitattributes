# Global fallback: auto-detect text files and enforce LF
* text=auto eol=lf

# Windows Batch scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts
*.ps1 text eol=crlf

# Shell scripts must use LF to avoid syntax errors on Linux
*.sh text eol=lf

# Python source files enforce LF (PEP 8 standard)
*.py text eol=lf